use ::java::util::text::Text

// Source dialog scripts also support graph helpers outside JSON:
// @label_name, -> label_name, ? condition:value -> label_name, condition blocks
// ? condition:value { ... } { ... }, and ! end. Label names must match [A-Za-z0-9_.-]+.
// Source action shorthands: ! give_item <material> <amount>,
// ! give_currency <BLOOD_ORB|SILVER> <amount>, ! teleport <location>,
// ! set_flag <key> [true|false|string:value|int:value], and ! clear_flag <key>.

dispatch minecraft:resource[blood:blood-dialog] to struct Dialog {
  id: string,
  /// True by default
  condition?: Condition,
  actors: [Actor],
  root: [Node],
}

struct Condition {
  condition: string,
  /// Provider argument, for example a flag key, quest id, level, or "<quest_id>:<stage_number>" for quest_stage.
  value?: string,
  and?: [Condition],
  or?: [Condition],
  not?: Condition,
}

struct Actor {
  /// Can be used as ref in TellNode
  id: string,
  entity: string,
}

// --- Nodes ---

dispatch blood:nodes[blood:tell_node] to struct {
  text: Text,
  actor: string,
  pauseAfterMessage?: boolean,
}

dispatch blood:nodes[blood:say_node] to struct {
  text: Text,
  pauseAfterMessage?: boolean,
}

dispatch blood:nodes[blood:branch_node] to struct {
  condition: Condition,
  label: string,
}

struct ConditionBranch {
  condition: Condition,
  label: string,
  /// Lower priorities are tested first. If omitted, JSON order is used after prioritized branches.
  priority?: int,
}

dispatch blood:nodes[blood:condition_branch_node] to struct {
  branches: [ConditionBranch],
  fallback?: string,
}

struct Choice {
  text: Text,
  /// Jumps to said label
  label: string,
}

dispatch blood:nodes[blood:choice_node] to struct {
  choices: [Choice],
}

dispatch blood:nodes[blood:label_node] to struct {
  label: string,
}

dispatch blood:nodes[blood:action_node] to struct {
  action: Action,
}

dispatch blood:nodes[blood:chapter_node] to struct {
  name: string @ 1..,
  children: [Node],
}

dispatch blood:nodes[blood:end_node] to struct {
}

dispatch minecraft:resource[blood:nodes] to struct Node {
  type: NodeType,
  ...blood:nodes[[type]],
}

enum(string) NodeType {
  TellNode = "blood:tell_node",
  SayNode = "blood:say_node",
  BranchNode = "blood:branch_node",
  ConditionBranchNode = "blood:condition_branch_node",
  ChoiceNode = "blood:choice_node",
  LabelNode = "blood:label_node",
  ActionNode = "blood:action_node",
  ChapterNode = "blood:chapter_node",
  EndNode = "blood:end_node"
}

// --- Actions ---

dispatch minecraft:resource[blood:actions] to struct Action {
  type: ActionType,
  ...blood:actions[[type]],
}

dispatch blood:actions[blood:command_action] to struct {
  command: string,
}

dispatch blood:actions[blood:set_actor_name_action] to struct {
  actorName: Text,
}

dispatch blood:actions[blood:give_item_action] to struct {
  item: ItemDefinition,
}

enum(string) Currency {
  BloodOrb = "BLOOD_ORB",
  Silver = "SILVER",
}

dispatch blood:actions[blood:give_currency_action] to struct {
  currency: Currency,
  amount: int@1..,
}

dispatch blood:actions[blood:teleport_action] to struct {
  /// `world x y z` or `/execute in minecraft:overworld run tp @s x y z yaw pitch`.
  location: string,
}

enum(string) PlayerFlagValueType {
  Boolean = "BOOLEAN",
  String = "STRING",
  Int = "INT",
}

dispatch blood:actions[blood:set_player_flag_action] to struct {
  key: string,
  /// Defaults to boolean true when omitted.
  value?: string,
  valueType?: PlayerFlagValueType,
}

dispatch blood:actions[blood:clear_player_flag_action] to struct {
  key: string,
}

// --- Item Definitions ---

enum(string) ItemDefinitionType {
  ItemStack = "blood:item_stack",
  Material = "blood:material",
}

dispatch minecraft:resource[blood:dialog_item_definition] to struct ItemDefinition {
  type: ItemDefinitionType,
  ...blood:item_definition[[type]],
}

dispatch blood:item_definition[blood:item_stack] to struct {
  /// Bukkit ItemStack serialized data.
  yml: string,
}

dispatch blood:item_definition[blood:material] to struct {
  material: string,
  amount: int@1..,
}

enum(string) ActionType {
  Command = "blood:command_action",
  SetActorName = "blood:set_actor_name_action",
  GiveItem = "blood:give_item_action",
  GiveCurrency = "blood:give_currency_action",
  Teleport = "blood:teleport_action",
  SetPlayerFlag = "blood:set_player_flag_action",
  ClearPlayerFlag = "blood:clear_player_flag_action"
}
