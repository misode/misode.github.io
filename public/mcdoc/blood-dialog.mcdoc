struct LocalizedText {
  /// Ключ локализации ресурспака. Создаётся при сохранении, если поле пустое.
  key?: string,
  en_us?: string,
  ru_ru?: string,
  /// Значения для плейсхолдеров %s в lang-строке.
  arguments?: [LocalizedText],
  /// Дополнительные части текста, добавленные после этого текста.
  append?: [LocalizedText],
  color?: string,
  shadow_color?: string,
  font?: string,
  bold?: boolean,
  italic?: boolean,
  underlined?: boolean,
  strikethrough?: boolean,
  obfuscated?: boolean,
  insertion?: string,
  click_event?: ClickEvent,
  hover_event?: HoverEvent,
}

struct ClickEvent {
  action: string,
  value: string,
}

struct HoverEvent {
  action: string,
  value: string,
}

// Source-скрипты диалогов также поддерживают вспомогательный графовый синтаксис вне JSON:
// @label_name, -> label_name, ? condition:value -> label_name, блоки условий
// ? condition:value { ... } { ... } и ! end. Имена label должны совпадать с [A-Za-z0-9_.-]+.
// Короткие source-action команды: ! give_item <material> <amount>,
// ! give_currency <BLOOD_ORB|SILVER> <amount>, ! teleport <location>,
// ! set_flag <key> [true|false|string:value|int:value] и ! clear_flag <key>.

dispatch minecraft:resource[blood:blood-dialog] to struct Dialog {
  id: string,
  /// По умолчанию true.
  condition?: Condition,
  actors: [Actor],
  root: [Node],
}

struct Condition {
  condition: string,
  /// Аргумент провайдера: например ключ флага, id квеста, уровень или "<quest_id>:<stage_number>" для quest_stage.
  value?: string,
  and?: [Condition],
  or?: [Condition],
  not?: Condition,
}

struct Actor {
  /// Можно использовать как ref в TellNode.
  id: string,
  entity: string,
}

// --- Nodes ---

dispatch blood:nodes[blood:tell_node] to struct {
  /// Локализованный текст. Укажите key вручную или оставьте пустым, чтобы ключ создался при сохранении.
  text?: LocalizedText,
  actor: string,
  pauseAfterMessage?: boolean,
}

dispatch blood:nodes[blood:say_node] to struct {
  /// Локализованный текст. Укажите key вручную или оставьте пустым, чтобы ключ создался при сохранении.
  text?: LocalizedText,
  pauseAfterMessage?: boolean,
}

dispatch blood:nodes[blood:branch_node] to struct {
  condition: Condition,
  label: string,
}

struct ConditionBranch {
  condition: Condition,
  label: string,
  /// Меньший priority проверяется раньше. Если поле пустое, после priority-веток используется порядок JSON.
  priority?: int,
}

dispatch blood:nodes[blood:condition_branch_node] to struct {
  branches: [ConditionBranch],
  fallback?: string,
}

struct Choice {
  /// Локализованный текст. Укажите key вручную или оставьте пустым, чтобы ключ создался при сохранении.
  text?: LocalizedText,
  /// Переход к указанному label.
  label: string,
}

dispatch blood:nodes[blood:choice_node] to struct {
  choices: [Choice],
}

dispatch blood:nodes[blood:label_node] to struct {
  label: string,
}

dispatch blood:nodes[blood:action_node] to struct {
  action: Action,
}

dispatch blood:nodes[blood:chapter_node] to struct {
  name: string @ 1..,
  children: [Node],
}

dispatch blood:nodes[blood:end_node] to struct {
}

dispatch minecraft:resource[blood:nodes] to struct Node {
  type: NodeType,
  ...blood:nodes[[type]],
}

enum(string) NodeType {
  TellNode = "blood:tell_node",
  SayNode = "blood:say_node",
  BranchNode = "blood:branch_node",
  ConditionBranchNode = "blood:condition_branch_node",
  ChoiceNode = "blood:choice_node",
  LabelNode = "blood:label_node",
  ActionNode = "blood:action_node",
  ChapterNode = "blood:chapter_node",
  EndNode = "blood:end_node"
}

// --- Actions ---

dispatch minecraft:resource[blood:actions] to struct Action {
  type: ActionType,
  ...blood:actions[[type]],
}

dispatch blood:actions[blood:command_action] to struct {
  command: string,
}

dispatch blood:actions[blood:set_actor_name_action] to struct {
  /// Локализованный текст. Укажите key вручную или оставьте пустым, чтобы ключ создался при сохранении.
  actorName?: LocalizedText,
}

dispatch blood:actions[blood:give_item_action] to struct {
  item: ItemDefinition,
}

enum(string) Currency {
  BloodOrb = "BLOOD_ORB",
  Silver = "SILVER",
}

dispatch blood:actions[blood:give_currency_action] to struct {
  currency: Currency,
  amount: int@1..,
}

dispatch blood:actions[blood:teleport_action] to struct {
  /// `world x y z` or `/execute in minecraft:overworld run tp @s x y z yaw pitch`.
  location: string,
}

enum(string) PlayerFlagValueType {
  Boolean = "BOOLEAN",
  String = "STRING",
  Int = "INT",
}

dispatch blood:actions[blood:set_player_flag_action] to struct {
  key: string,
  /// Если поле пустое, используется boolean true.
  value?: string,
  valueType?: PlayerFlagValueType,
}

dispatch blood:actions[blood:clear_player_flag_action] to struct {
  key: string,
}

// --- Item Definitions ---

enum(string) ItemDefinitionType {
  ItemStack = "blood:item_stack",
  Material = "blood:material",
  ArcItem = "blood:arc_item",
  ArcPotion = "blood:arc_potion",
}

dispatch minecraft:resource[blood:dialog_item_definition] to struct ItemDefinition {
  type: ItemDefinitionType,
  ...blood:item_definition[[type]],
}

dispatch blood:item_definition[blood:item_stack] to struct {
  /// Сериализованные данные Bukkit ItemStack.
  yml: string,
}

dispatch blood:item_definition[blood:material] to struct {
  material: string,
  amount: int@1..,
}

dispatch blood:item_definition[blood:arc_item] to struct {
  id: string,
  amount: int@1..,
}

dispatch blood:item_definition[blood:arc_potion] to struct {
  id: string,
  amount: int@1..,
}

enum(string) ActionType {
  Command = "blood:command_action",
  SetActorName = "blood:set_actor_name_action",
  GiveItem = "blood:give_item_action",
  GiveCurrency = "blood:give_currency_action",
  Teleport = "blood:teleport_action",
  SetPlayerFlag = "blood:set_player_flag_action",
  ClearPlayerFlag = "blood:clear_player_flag_action"
}
