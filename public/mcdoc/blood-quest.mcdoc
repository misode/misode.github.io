dispatch minecraft:resource[blood:blood-quest] to struct Quest {
  id: string,
  type: QuestType,
  /// Localized text. Set key manually or leave it empty to generate a lang key on save.
  name?: LocalizedText,
  /// Localized text. Set key manually or leave it empty to generate a lang key on save.
  description?: LocalizedText,
  /// True by default
  condition?: Condition,
  activation?: Activation,
  /// Actor id of the NPC that offers the quest
  giverActor?: string,
  /// Actor id of the NPC that gives the reward
  rewardActor?: string,
  /// String custom model data used by quest GUIs
  icon?: string,
  /// Changing this will reset players' progress if quest is active upon reload
  version: string,
  rewards: [Reward],
  stages: [Stage],
}

enum(string) QuestType {
  Campaign = "campaign",
  Side = "side",
  Daily = "daily",
  Weekly = "weekly",
  Event = "event",
}

enum(string) RewardType {
  Item = "blood:item",
  Currency = "blood:currency",
}

enum(string) ActivationType {
  Dialog = "dialog",
}

// --- Rewards ---

dispatch minecraft:resource[blood:reward] to struct Reward {
  type: RewardType,
  ...blood:reward[[type]],
}

dispatch blood:reward[blood:item] to struct {
  item: ItemDefinition,
}

enum(string) Currency {
  BloodOrb = "BLOOD_ORB",
  Silver = "SILVER",
}

dispatch blood:reward[blood:currency] to struct {
  currency: Currency,
  amount: int@1..,
}

// --- Item Definitions ---

enum(string) ItemDefinitionType {
  ItemStack = "blood:item_stack",
  Material = "blood:material",
  ArcItem = "blood:arc_item",
  ArcPotion = "blood:arc_potion",
}

dispatch minecraft:resource[blood:reward] to struct ItemDefinition {
  type: ItemDefinitionType,
  ...blood:item_definition[[type]],
}

dispatch blood:item_definition[blood:item_stack] to struct {
  /// Bukkit ItemStack serialized data
  yml: string,
}

dispatch blood:item_definition[blood:material] to struct {
  material: string,
  amount: int@1..,
}

dispatch blood:item_definition[blood:arc_item] to struct {
  id: string,
  amount: int@1..,
}

dispatch blood:item_definition[blood:arc_potion] to struct {
  id: string,
  amount: int@1..,
}

// --- Helper Structs ---

struct Condition {
  condition: string,
  /// Provider argument, for example a flag key, quest id, level, or "<quest_id>:<stage_number>" for quest_stage.
  value?: string,
  and?: [Condition],
  or?: [Condition],
  not?: Condition,
}

struct LocalizedText {
  /// Resource-pack lang key. Generated on save when omitted.
  key?: string,
  en_us?: string,
  ru_ru?: string,
  /// Placeholder values for %s in the lang string.
  arguments?: [LocalizedText],
  /// Extra text parts appended after this text.
  append?: [LocalizedText],
  color?: string,
  shadow_color?: string,
  font?: string,
  bold?: boolean,
  italic?: boolean,
  underlined?: boolean,
  strikethrough?: boolean,
  obfuscated?: boolean,
  insertion?: string,
  click_event?: ClickEvent,
  hover_event?: HoverEvent,
}

struct ClickEvent {
  action: string,
  value: string,
}

struct HoverEvent {
  action: string,
  value: string,
}

dispatch minecraft:resource[blood:activation] to struct Activation {
  type: ActivationType,
  ...blood:activation[[type]],
}

dispatch blood:activation[dialog] to struct {
  startDialog: string,
}

dispatch minecraft:resource[blood:stage] to struct Stage {
  /// Localized text. Set key manually or leave it empty to generate a lang key on save.
  name?: LocalizedText,
  coordinates: QuestLocation,
  goals: [Goal]
}

type QuestLocation = (QuestPosition | string)

struct QuestPosition {
  world: string,
  x: double,
  y: double,
  z: double,
  yaw?: float,
  pitch?: float,
}

struct Area {
  /// Center coordinates
  location: QuestLocation,
  /// Radius in blocks
  radius: float,
}

// --- Goals ---

enum(string) GoalType {
  Kill = "blood:kill",
  Gather = "blood:gather",
  Deliver = "blood:deliver",
  Talk = "blood:talk",
  Reach = "blood:reach",
  InteractEntity = "blood:interact_entity",
  InteractBlock = "blood:interact_block",
  ShootArea = "blood:shoot_area",
  Consume = "blood:consume",
  Dialog = "blood:dialog",
  Die = "blood:die", // lmao
  KillPlayer = "blood:kill_player",
  Level = "blood:level",
  Craft = "blood:craft",
  Dungeon = "blood:dungeon",
  InteractObject = "blood:interact_object",
  NpcZone = "blood:npc_zone",
  Condition = "blood:condition",
  ScoreboardTag = "blood:scoreboard_tag",
}

dispatch minecraft:resource[blood:goal] to struct Goal {
  /// Stable unique id; generated on server save when omitted
  id?: string,
  type: GoalType,
  ...blood:goal[[type]],
}

dispatch blood:goal[blood:kill] to struct {
  /// Registry key. Use either entity_type or mythic_mob.
  entity_type?: string,
  /// MythicMobs internal name. Use either mythic_mob or entity_type.
  mythic_mob?: string,
  /// Amount of entities to kill
  amount: int@1..,
}

dispatch blood:goal[blood:gather] to struct {
  item: ItemDefinition,
}

dispatch blood:goal[blood:deliver] to struct {
  item: ItemDefinition,
  /// ActorId of NPC to whom to deliver
  actor: string,
}

dispatch blood:goal[blood:talk] to struct {
  /// ActorId of NPC to whom to talk
  actor: string,
}

dispatch blood:goal[blood:reach] to struct {
  area: Area,
}

dispatch blood:goal[blood:interact_entity] to struct {
  /// Entity registry key
  entity_type: string,
}

dispatch blood:goal[blood:interact_block] to struct {
  /// Block position
  block?: QuestLocation,
  /// Multiple block positions; every position must be used once
  blocks?: [QuestLocation],
}

dispatch blood:goal[blood:shoot_area] to struct {
  area: Area,
}

dispatch blood:goal[blood:consume] to struct {
  item: ItemDefinition,
  amount: int@1..,
}

dispatch blood:goal[blood:dialog] to struct {
  dialog: string,
}

dispatch blood:goal[blood:die] to struct {
}

dispatch blood:goal[blood:kill_player] to struct {
  // TODO: Player Predicate?
  amount: int@1..,
}

dispatch blood:goal[blood:level] to struct {
  level: int@1..,
}

dispatch blood:goal[blood:craft] to struct {
  item: ItemDefinition,
  amount: int@1..,
}

enum(string) DungeonMode {
  Solo = "SOLO",
  Party = "PARTY",
}

dispatch blood:goal[blood:dungeon] to struct {
  dungeon: string,
  mode: DungeonMode,
  /// Defaults to 3 for PARTY
  min_players?: int@1..,
}

dispatch blood:goal[blood:interact_object] to struct {
  objectId: string,
  amount: int@1..,
}

enum(string) ZoneDirection {
  Enter = "ENTER",
  Exit = "EXIT",
}

dispatch blood:goal[blood:npc_zone] to struct {
  actor: string,
  radius: float@0.1..,
  direction: ZoneDirection,
}

dispatch blood:goal[blood:condition] to struct {
  condition: Condition,
}

dispatch blood:goal[blood:scoreboard_tag] to struct {
  tag: string,
}
